{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kestrel-contracts.dev/mission.schema.json",
  "title": "Mission",
  "description": "A single drone delivery mission between two medical facilities.",
  "type": "object",
  "required": ["id", "status", "priority", "payload", "origin", "destination", "createdAt"],
  "properties": {
    "id": { "type": "string", "pattern": "^msn_[0-9A-HJKMNP-TV-Z]{26}$" },
    "status": {
      "type": "string",
      "enum": ["queued", "airspace_pending", "cleared", "in_flight", "delivered", "aborted", "returned"]
    },
    "priority": { "type": "string", "enum": ["routine", "urgent", "stat"] },
    "droneId": { "type": "string" },
    "payload": {
      "type": "object",
      "required": ["kind", "temperatureClass", "specimenIds", "massGrams"],
      "properties": {
        "kind": { "type": "string", "enum": ["blood_product", "lab_sample", "organ", "pharmaceutical"] },
        "temperatureClass": { "type": "string", "enum": ["ambient", "refrigerated_2_8c", "frozen_minus20c", "cryogenic"] },
        "specimenIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "massGrams": { "type": "integer", "minimum": 1, "maximum": 4500 }
      },
      "additionalProperties": false
    },
    "origin": { "$ref": "#/$defs/facility" },
    "destination": { "$ref": "#/$defs/facility" },
    "etaSeconds": { "type": "integer", "minimum": 0 },
    "createdAt": { "type": "string", "format": "date-time" },
    "deliveredAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "facility": {
      "type": "object",
      "required": ["facilityId", "name", "latitude", "longitude"],
      "properties": {
        "facilityId": { "type": "string" },
        "name": { "type": "string" },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "padId": { "type": "string" }
      }
    }
  }
}
